# Copy to .env.local once the dev stacks are deployed (cdk outputs print them).
# Without these the app runs in "not configured" mode and shows a setup notice.

# e.g. https://dzidzo-dev-123456.auth.us-east-1.amazoncognito.com
VITE_COGNITO_AUTHORITY=
# The web app client id from the auth stack output
VITE_COGNITO_CLIENT_ID=
# e.g. https://abc123.execute-api.us-east-1.amazonaws.com/dev
VITE_API_URL=

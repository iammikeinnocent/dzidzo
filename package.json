{
  "name": "dzidzo",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dzidzo/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "synth": "pnpm --filter @dzidzo/infra synth",
    "db:start": "docker compose up -d dynamodb-local",
    "db:stop": "docker compose down",
    "seed:demo": "tsx scripts/seed-demo-users.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1155.0"
  }
}
